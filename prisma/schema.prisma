generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  status    String
  tag       String?
  notes     String?
  createdAt DateTime @default(now())
}

model Appointment {
  id        String   @id @default(cuid())
  client    String
  service   String
  date      String
  time      String
  status    String
  createdAt DateTime @default(now())
}

model CompanySettings {
  id            String   @id @default(cuid())
  companyName   String
  businessHours String
  address       String
  services      String
  autoMessage   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  client    String
  content   String
  direction String
  createdAt DateTime @default(now())
}